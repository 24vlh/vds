{
  "name": "@24vlh/vds",
  "version": "0.3.8",
  "description": "VDS — Vlah Design System CSS Framework",
  "author": "@vlah.io",
  "license": "Apache-2.0",
  "keywords": [
    "css",
    "design-system",
    "architecture",
    "framework",
    "vds",
    "vlah"
  ],
  "main": "dist/vds.css",
  "style": "dist/vds.css",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/24vlh/vds.git"
  },
  "scripts": {
    "browser:smoke": "node static/js/validate-browser-smoke.js",
    "build": "NODE_ENV=development node static/js/build.js",
    "build:prod": "NODE_ENV=production node static/js/build.js",
    "audit": "pnpm run audit:css && pnpm run audit:classes && pnpm run audit:tokens && pnpm run audit:docs && pnpm run audit:selectors && pnpm run audit:dist && pnpm run audit:package && pnpm run audit:browser && pnpm run audit:consumers",
    "audit:browser": "pnpm run browser:smoke",
    "audit:classes": "node static/js/find-bogus-classes.js",
    "audit:css": "node static/js/validate-css.js",
    "audit:consumers": "node static/js/validate-consumer-compatibility.js",
    "audit:dist": "node static/js/validate-dist-presence.js && pnpm run dist:check",
    "audit:docs": "node static/js/validate-doc-dependencies.js && node static/js/validate-doc-quality.js && pnpm run audit:docs:metadata",
    "audit:docs:metadata": "node ../agents/tools/vds-index.mjs --source /mnt/w/public_html/24vlh/vds/doc-raw --out /mnt/w/public_html/24vlh/agents/docs_vds --check",
    "audit:package": "pnpm run package:smoke",
    "audit:selectors": "node static/js/validate-selector-contract.js",
    "audit:tokens": "node static/js/validate-used-tokens.js",
    "doc:serve": "node static/js/server.js",
    "docs:vds:index": "node ../agents/tools/vds-index.mjs --source /mnt/w/public_html/24vlh/vds/doc-raw --out /mnt/w/public_html/24vlh/agents/docs_vds",
    "dist:check": "node static/js/validate-dist-freshness.js",
    "dist:refresh": "NODE_ENV=development node static/js/build.js --out dist",
    "inventory": "pnpm run inventory:selectors && pnpm run inventory:tokens",
    "inventory:selectors": "node static/js/generate-selector-inventory.js",
    "inventory:tokens": "node static/js/generate-token-inventory.js",
    "package:smoke": "node static/js/validate-package-smoke.js",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "autoprefixer": "^10.4.24",
    "axe-core": "^4.11.4",
    "cssnano": "^7.1.2",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright-core": "^1.60.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^11.2.0",
    "rimraf": "^6.1.3"
  },
  "lint-staged": {
    "src/**/*.css": [
      "pnpm run audit:css",
      "pnpm run audit:tokens"
    ]
  }
}
